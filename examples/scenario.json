{
  "scenario_id": "example_2026q2",
  "stress_levels": ["S1", "S2"],
  "run": {
    "cutoff_date": "2026-06-30"
  },
  "outputs": {
    "directory": "outputs/example_2026q2"
  },
  "module_priority": ["CRE", "C&I", "Consumer"],
  "inputs": {
    "identity": {
      "path": "data/loans.csv",
      "type": "csv",
      "date_columns": ["maturity_date"],
      "numeric_columns": ["risk_rating", "outstanding_balance", "cecl_reserve"],
      "required_columns": ["loan_id", "borrower_id", "subsector", "outstanding_balance"]
    },
    "sources": {
      "financials": {
        "path": "data/financials.csv",
        "type": "csv",
        "date_columns": ["current_dscr_date", "prior_dscr_date"],
        "key": "borrower_id",
        "expect_unique_key": true,
        "numeric_columns": [
          "current_dscr",
          "prior_dscr",
          "origination_dscr",
          "noi",
          "ebitda",
          "cash_taxes",
          "cash_distribution",
          "cash_dividends",
          "discretionary_cash_dividends_distribution",
          "cash_management_fees",
          "unfinanced_capex",
          "global_total_outstanding",
          "cash_paid_for_interest",
          "principal_repayments_paid",
          "required_principal_paid_period",
          "fccr"
        ],
        "aggregation": {
          "dscr": {
            "method": "best_available",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "date_output": "dscr_date",
            "source_field_output": "dscr_source_field",
            "candidate_output": "dscr_candidate",
            "candidates": [
              {"field": "current_dscr", "date_field": "current_dscr_date", "label": "current"},
              {"field": "prior_dscr", "date_field": "prior_dscr_date", "label": "prior"},
              {"field": "origination_dscr", "label": "origination"}
            ]
          },
          "noi": "first",
          "ebitda": "first",
          "cash_taxes": "first",
          "cash_distribution": "first",
          "cash_dividends": "first",
          "discretionary_cash_dividends_distribution": "first",
          "cash_management_fees": "first",
          "unfinanced_capex": "first",
          "global_total_outstanding": "first",
          "cash_paid_for_interest": "first",
          "principal_repayments_paid": "first",
          "required_principal_paid_period": "first",
          "fccr": "first"
        }
      },
      "collateral": {
        "path": "data/collateral.csv",
        "type": "csv",
        "key": "borrower_id",
        "date_columns": ["current_appraisal_date", "prior_appraisal_date"],
        "numeric_columns": ["current_appraised_value_raw", "prior_appraised_value", "origination_appraised_value"],
        "aggregation": {
          "current_appraised_value": {
            "method": "best_available_unique_sum",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "unique_fields": ["collateral_id"],
            "date_output": "appraisal_date",
            "source_field_output": "appraisal_source_field",
            "candidate_output": "appraisal_candidate",
            "candidates": [
              {"field": "current_appraised_value_raw", "date_field": "current_appraisal_date", "label": "current"},
              {"field": "prior_appraised_value", "date_field": "prior_appraisal_date", "label": "prior"},
              {"field": "origination_appraised_value", "label": "origination"}
            ]
          }
        }
      },
      "consumer_scores": {
        "path": "data/consumer_scores.csv",
        "type": "csv",
        "key": "borrower_id",
        "date_columns": ["current_fico_date", "origination_fico_date"],
        "numeric_columns": ["current_fico_score", "origination_fico_score"],
        "aggregation": {
          "fico_score": {
            "method": "best_available",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "date_output": "fico_date",
            "source_field_output": "fico_source_field",
            "candidate_output": "fico_candidate",
            "candidates": [
              {"field": "current_fico_score", "date_field": "current_fico_date", "label": "current"},
              {"field": "origination_fico_score", "date_field": "origination_fico_date", "label": "origination"}
            ]
          }
        }
      },
      "fico_pd_lookup": {
        "path": "data/fico_pd_lookup.csv",
        "type": "csv",
        "merge": false,
        "numeric_columns": ["min_score", "max_score", "pd"]
      },
      "tag_tieouts": {
        "path": "data/tag_tieouts.csv",
        "type": "csv",
        "merge": false,
        "numeric_columns": ["expected_balance"]
      }
    }
  },
  "borrower": {
    "borrower_id_field": "borrower_id",
    "loan_id_field": "loan_id",
    "portfolio_field": "model_portfolio",
    "module_field": "model_module",
    "balance_field": "outstanding_balance",
    "balance_fields": ["outstanding_balance"],
    "sum_fields": ["outstanding_balance", "cecl_reserve"],
    "risk_rating_field": "risk_rating",
    "maturity_date_field": "maturity_date",
    "default_aggregation": "first",
    "aggregation": {
      "loan_id": "list_unique",
      "borrower_name": "first",
      "status": "first",
      "subsector": "first",
      "tag_hint": "first",
      "risk_rating": "max",
      "maturity_date": "min",
      "outstanding_balance": "sum",
      "cecl_reserve": "sum"
    }
  },
  "tags": {
    "CRE_Model": {
      "model_eligible": true,
      "include": {
        "any": [
          {"field": "subsector", "op": "has_token", "value": "Multifamily Rent Regulated"},
          {"field": "subsector", "op": "has_token", "value": "Multifamily Market"},
          {"field": "subsector", "op": "has_token", "value": "Traditional Office"},
          {"field": "subsector", "op": "has_token", "value": "Medical Office"},
          {"field": "subsector", "op": "has_token", "value": "Industrial"},
          {"field": "subsector", "op": "has_token", "value": "Skilled Nursing Facilities"},
          {"field": "subsector", "op": "has_token", "value": "Senior Living"},
          {"field": "subsector", "op": "has_token", "value": "Retail"},
          {"field": "subsector", "op": "has_token", "value": "Hotel"}
        ]
      },
      "exclude": {
        "any": [
          {"field": "status", "op": "in", "value": ["Paid Off", "Charged Off"]}
        ]
      },
      "assign": {
        "model_portfolio": "CRE",
        "model_module": "CRE"
      }
    },
    "CI_Model": {
      "model_eligible": true,
      "include": {
        "any": [
          {"field": "subsector", "op": "has_any_token", "value": ["Sponsor and Specialty", "Middle Market", "Asset-Based Lending"]},
          {"field": "tag_hint", "op": "has_any_token", "value": ["Middle Market"]}
        ]
      },
      "assign": {
        "model_portfolio": "C&I",
        "model_module": "C&I"
      }
    },
    "Consumer_Model": {
      "model_eligible": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Consumer"}
      ],
      "assign": {
        "model_portfolio": "Consumer",
        "model_module": "Consumer"
      }
    },
    "Equipment_Finance_Overlay": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Equipment Finance"}
      ],
      "assign": {
        "model_portfolio": "EF",
        "model_module": "Overlay"
      }
    },
    "Business_Credit_Center_Overlay": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Business Credit Center"}
      ],
      "assign": {
        "model_portfolio": "BCC",
        "model_module": "Overlay"
      }
    },
    "CRE_Subsector_Multifamily_Rent_Regulated": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Multifamily Rent Regulated"}
      ],
      "assign": {"cre_subsector": "Multifamily Rent Regulated"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Multifamily_Market": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Multifamily Market"}
      ],
      "assign": {"cre_subsector": "Multifamily Market"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Traditional_Office": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Traditional Office"}
      ],
      "assign": {"cre_subsector": "Traditional Office"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Medical_Office": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Medical Office"}
      ],
      "assign": {"cre_subsector": "Medical Office"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Industrial": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Industrial"}
      ],
      "assign": {"cre_subsector": "Industrial"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Skilled_Nursing_Facilities": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Skilled Nursing Facilities"}
      ],
      "assign": {"cre_subsector": "Skilled Nursing Facilities"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Senior_Living": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Senior Living"}
      ],
      "assign": {"cre_subsector": "Senior Living"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Retail": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Retail"}
      ],
      "assign": {"cre_subsector": "Retail"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CRE_Subsector_Hotel": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Hotel"}
      ],
      "assign": {"cre_subsector": "Hotel"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CI_Sector_Sponsor_and_Specialty": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Sponsor and Specialty"}
      ],
      "assign": {"ci_sector": "Sponsor and Specialty"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CI_Sector_Middle_Market": {
      "model_eligible": false,
      "internal_only": true,
      "include": {
        "any": [
          {"field": "subsector", "op": "has_token", "value": "Middle Market"},
          {"field": "tag_hint", "op": "has_token", "value": "Middle Market"}
        ]
      },
      "assign": {"ci_sector": "Middle Market"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    },
    "CI_Sector_Asset_Based_Lending": {
      "model_eligible": false,
      "internal_only": true,
      "include": [
        {"field": "subsector", "op": "has_token", "value": "Asset-Based Lending"}
      ],
      "assign": {"ci_sector": "Asset-Based Lending"},
      "tie_out": {
        "source": "tag_tieouts",
        "key_field": "tag",
        "amount_field": "expected_balance",
        "actual_field": "outstanding_balance",
        "tolerance": 0.01
      }
    }
  },
  "module_order": ["CRE", "C&I", "Consumer"],
  "modules": {
    "CRE": {
      "enabled": true,
      "eligible_tags": ["CRE_Model"],
      "subsector_field": "cre_subsector",
      "cecl_portfolio_field": "cre_subsector",
      "cecl_portfolio_rollup": "CRE",
      "maturity_threshold_months": 12,
      "noi_balance_ratio_acceptable_range": [0.01, 0.30],
      "tests": {
        "dscr": {
          "field": "dscr",
          "decline": {
            "default": {"S1": 0.05, "S2": 0.10},
            "Traditional Office": {"S1": 0.05, "S2": 0.10},
            "Multifamily Rent Regulated": {"S1": 0.04, "S2": 0.08},
            "Multifamily Market": {"S1": 0.05, "S2": 0.10},
            "Medical Office": {"S1": 0.04, "S2": 0.08},
            "Industrial": {"S1": 0.04, "S2": 0.08},
            "Skilled Nursing Facilities": {"S1": 0.06, "S2": 0.12},
            "Senior Living": {"S1": 0.06, "S2": 0.12},
            "Retail": {"S1": 0.06, "S2": 0.12},
            "Hotel": {"S1": 0.08, "S2": 0.15}
          },
          "cutoffs": {"special_mention": 1.15, "substandard": 1.00},
          "acceptable_range": [0.20, 5.00]
        },
        "refinance": {
          "noi_field": "noi",
          "treasury_rate": 0.04,
          "credit_spreads": {
            "default": {"S1": 0.02, "S2": 0.03}
          },
          "amortization_years": {
            "default": {"S1": 25, "S2": 25}
          },
          "cutoffs": {"special_mention": 1.15, "substandard": 1.00}
        },
        "ltv": {
          "noi_field": "noi",
          "cap_rates": {
            "default": {"S1": 0.075, "S2": 0.085}
          },
          "cutoffs": {"special_mention": 0.75, "substandard": 0.90}
        }
      }
    },
    "C&I": {
      "enabled": true,
      "eligible_tags": ["CI_Model"],
      "sector_field": "ci_sector",
      "cecl_portfolio_field": "ci_sector",
      "current_fccr_field": "fccr",
      "ebitda_reduction": {
        "default": {
          "Pass": {"S1": 0.10, "S2": 0.20},
          "Special Mention": {"S1": 0.12, "S2": 0.25},
          "Substandard": {"S1": 0.00, "S2": 0.00}
        }
      },
      "interest_rate_stress": {"S1": 0.01, "S2": 0.02},
      "cutoffs": {"special_mention": 1.15, "substandard": 1.00},
      "sectors": {
        "Sponsor and Specialty": {
          "principal_field": "required_principal_paid_period",
          "include_non_discretionary_dividends": false
        },
        "Middle Market": {
          "principal_field": "principal_repayments_paid",
          "include_non_discretionary_dividends": true
        },
        "Asset-Based Lending": {
          "principal_field": "required_principal_paid_period",
          "include_non_discretionary_dividends": true
        }
      }
    },
    "Consumer": {
      "enabled": true,
      "eligible_tags": ["Consumer_Model"],
      "pd_lookup_source": "fico_pd_lookup",
      "fico_candidates": [
        {"score_field": "fico_score", "date_field": "fico_date"}
      ],
      "appraisal_candidates": [
        {"value_field": "current_appraised_value", "date_field": "appraisal_date"}
      ],
      "pd_increase_factor": {"S1": 1.25, "S2": 1.50},
      "collateral_value_factor": {"S1": 0.90, "S2": 0.80},
      "rushed_sale_discount": 0.05,
      "closing_costs": 0.02,
      "pd_cap": 1.00
    }
  },
  "overlays": {
    "EF": {
      "enabled": true,
      "sources": [
        {"name": "C&I", "tags": ["CI_Model"], "weight": 1.00}
      ]
    },
    "BCC": {
      "enabled": true,
      "sources": [
        {"name": "CRE", "tags": ["CRE_Model"], "weight": 0.65},
        {"name": "C&I", "tags": ["CI_Model"], "weight": 0.35}
      ]
    }
  },
  "cecl": {
    "reserve_field": "cecl_reserve",
    "portfolio_field": "cecl_portfolio",
    "portfolios": {
      "Consumer": {"method": "expected_loss"}
    }
  }
}
