{
  "$include": [
    "scenario/inputs.json",
    "scenario/tags/model_and_overlay.json",
    "scenario/tags/cre_subsectors.json",
    "scenario/tags/ci_sectors.json",
    "scenario/modules/cre.json",
    "scenario/modules/ci.json",
    "scenario/modules/consumer.json",
    "scenario/overlays.json"
  ],
  "scenario_id": "example_2026q2",
  "stress_levels": [
    "S1",
    "S2"
  ],
  "cutoffs": {
    "dscr": {
      "special_mention": 1.15,
      "substandard": 1.0
    },
    "fccr": {
      "special_mention": 1.15,
      "substandard": 1.0
    },
    "ltv": {
      "special_mention": 0.75,
      "substandard": 0.9
    }
  },
  "cecl": {
    "reserve_field": "cecl_reserve",
    "portfolio_field": "cecl_portfolio",
    "reserve_basis": {
      "method": "weighted_history",
      "central_tendency": {
        "z_score_threshold": 2.0,
        "observation_grain": "borrower"
      },
      "weighted_history": {
        "period_method": "in_place",
        "periods": [
          {
            "name": "2026Q2",
            "reserve_field": "cecl_reserve",
            "weight": 0.3333333333333333
          },
          {
            "name": "2026Q1",
            "reserve_field": "cecl_reserve_prior_1",
            "weight": 0.3333333333333333
          },
          {
            "name": "2025Q4",
            "reserve_field": "cecl_reserve_prior_2",
            "weight": 0.3333333333333333
          }
        ]
      }
    },
    "portfolios": {
      "Consumer": {
        "method": "expected_loss"
      }
    }
  },
  "run": {
    "cutoff_date": "2026-06-30"
  },
  "outputs": {
    "directory": "outputs/example_2026q2"
  },
  "module_order": [
    "CRE",
    "C&I",
    "Consumer"
  ]
}
