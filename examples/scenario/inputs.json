{
  "inputs": {
    "identity": {
      "path": "data/loans.csv",
      "type": "csv",
      "column_aliases": {
        "loan_id": "loan_id",
        "borrower_id": "borrower_id",
        "borrower_name": "borrower_name",
        "status": "status",
        "subsector": "subsector",
        "tag_hint": "tag_hint",
        "tag_hint_2": "tag_hint_2",
        "risk_rating": "risk_rating",
        "maturity_date": "maturity_date",
        "outstanding_balance": "outstanding_balance",
        "cecl_reserve": "cecl_reserve"
      },
      "date_columns": [
        "maturity_date"
      ],
      "numeric_columns": [
        "risk_rating",
        "outstanding_balance",
        "cecl_reserve"
      ],
      "required_columns": [
        "loan_id",
        "borrower_id",
        "subsector",
        "outstanding_balance"
      ]
    },
    "sources": {
      "financials": {
        "path": "data/financials.csv",
        "type": "csv",
        "key": "borrower_id",
        "column_aliases": {
          "borrower_id": "borrower_id",
          "ebitda": "ebitda",
          "cash_taxes": "cash_taxes",
          "cash_distribution": "cash_distribution",
          "cash_dividends": "cash_dividends",
          "discretionary_cash_dividends_distribution": "discretionary_cash_dividends_distribution",
          "cash_management_fees": "cash_management_fees",
          "unfinanced_capex": "unfinanced_capex",
          "global_total_outstanding": "global_total_outstanding",
          "cash_paid_for_interest": "cash_paid_for_interest",
          "principal_repayments_paid": "principal_repayments_paid",
          "required_principal_paid_period": "required_principal_paid_period"
        },
        "expect_unique_key": true,
        "numeric_columns": [
          "ebitda",
          "cash_taxes",
          "cash_distribution",
          "cash_dividends",
          "discretionary_cash_dividends_distribution",
          "cash_management_fees",
          "unfinanced_capex",
          "global_total_outstanding",
          "cash_paid_for_interest",
          "principal_repayments_paid",
          "required_principal_paid_period"
        ]
      },
      "collateral": {
        "path": "data/collateral.csv",
        "type": "csv",
        "key": "borrower_id",
        "column_aliases": {
          "borrower_id": "borrower_id",
          "collateral_id": "collateral_id",
          "current_appraisal_date": "current_appraisal_date",
          "current_appraised_value_raw": "current_appraised_value_raw",
          "prior_appraisal_date": "prior_appraisal_date",
          "prior_appraised_value": "prior_appraised_value",
          "origination_appraised_value": "origination_appraised_value",
          "current_dscr": "Current DSCR",
          "current_dscr_date": "Current DSCR Date",
          "prior_dscr": "Prior DSCR",
          "prior_dscr_date": "Prior DSCR Date",
          "origination_dscr": "Origination DSCR",
          "noi": "Net Operating Income"
        },
        "date_columns": [
          "current_appraisal_date",
          "prior_appraisal_date",
          "current_dscr_date",
          "prior_dscr_date"
        ],
        "numeric_columns": [
          "current_appraised_value_raw",
          "prior_appraised_value",
          "origination_appraised_value",
          "current_dscr",
          "prior_dscr",
          "origination_dscr",
          "noi"
        ],
        "aggregation": {
          "dscr": {
            "method": "best_available",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "date_output": "dscr_date",
            "source_field_output": "dscr_source_field",
            "candidate_output": "dscr_candidate",
            "source_record_output": "dscr_source_record",
            "candidates": [
              {
                "field": "current_dscr",
                "date_field": "current_dscr_date",
                "label": "current"
              },
              {
                "field": "prior_dscr",
                "date_field": "prior_dscr_date",
                "label": "prior"
              },
              {
                "field": "origination_dscr",
                "label": "origination"
              }
            ]
          },
          "noi": "first",
          "current_appraised_value": {
            "method": "best_available_unique_sum",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "unique_fields": [
              "collateral_id"
            ],
            "date_output": "appraisal_date",
            "source_field_output": "appraisal_source_field",
            "candidate_output": "appraisal_candidate",
            "source_record_output": "appraisal_source_record",
            "candidates": [
              {
                "field": "current_appraised_value_raw",
                "date_field": "current_appraisal_date",
                "label": "current"
              },
              {
                "field": "prior_appraised_value",
                "date_field": "prior_appraisal_date",
                "label": "prior"
              },
              {
                "field": "origination_appraised_value",
                "label": "origination"
              }
            ]
          }
        }
      },
      "consumer_scores": {
        "paths": [
          "data/consumer_scores_1.csv",
          "data/consumer_scores_2.csv"
        ],
        "type": "csv",
        "key": "borrower_id",
        "column_aliases": {
          "borrower_id": "borrower_id",
          "current_fico_score": "current_fico_score",
          "current_fico_date": "current_fico_date",
          "origination_fico_score": "origination_fico_score",
          "origination_fico_date": "origination_fico_date",
          "collateral_id": "collateral_id",
          "current_appraisal_date": "current_appraisal_date",
          "current_appraised_value_raw": "current_appraised_value_raw",
          "prior_appraisal_date": "prior_appraisal_date",
          "prior_appraised_value": "prior_appraised_value",
          "origination_appraised_value": "origination_appraised_value"
        },
        "date_columns": [
          "current_fico_date",
          "origination_fico_date",
          "current_appraisal_date",
          "prior_appraisal_date"
        ],
        "numeric_columns": [
          "current_fico_score",
          "origination_fico_score",
          "current_appraised_value_raw",
          "prior_appraised_value",
          "origination_appraised_value"
        ],
        "aggregation": {
          "fico_score": {
            "method": "best_available",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "date_output": "fico_date",
            "source_field_output": "fico_source_field",
            "candidate_output": "fico_candidate",
            "source_record_output": "fico_source_record",
            "candidates": [
              {
                "field": "current_fico_score",
                "date_field": "current_fico_date",
                "label": "current"
              },
              {
                "field": "origination_fico_score",
                "date_field": "origination_fico_date",
                "label": "origination"
              }
            ]
          },
          "consumer_appraised_value": {
            "method": "best_available_unique_sum",
            "selection": "precedence",
            "treat_zero_as_missing": true,
            "unique_fields": [
              "collateral_id"
            ],
            "date_output": "consumer_appraisal_date",
            "source_field_output": "consumer_appraisal_source_field",
            "candidate_output": "consumer_appraisal_candidate",
            "source_record_output": "consumer_appraisal_source_record",
            "candidates": [
              {
                "field": "current_appraised_value_raw",
                "date_field": "current_appraisal_date",
                "label": "current"
              },
              {
                "field": "prior_appraised_value",
                "date_field": "prior_appraisal_date",
                "label": "prior"
              },
              {
                "field": "origination_appraised_value",
                "label": "origination"
              }
            ]
          }
        }
      },
      "fico_pd_lookup": {
        "path": "data/fico_pd_lookup.csv",
        "type": "csv",
        "merge": false,
        "column_aliases": {
          "min_score": "min_score",
          "max_score": "max_score",
          "pd": "pd"
        },
        "numeric_columns": [
          "min_score",
          "max_score",
          "pd"
        ]
      },
      "tag_tieouts": {
        "path": "data/tag_tieouts.csv",
        "type": "csv",
        "merge": false,
        "column_aliases": {
          "tag": "tag",
          "expected_balance": "expected_balance"
        },
        "numeric_columns": [
          "expected_balance"
        ]
      }
    }
  }
}
