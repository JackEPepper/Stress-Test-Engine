{
  "engine_version": "0.1.0",
  "input_files": {
    "loan_identity": "loan_identity.csv",
    "cre_collateral": "cre_collateral.csv",
    "ci_financials": "ci_financials.csv",
    "fico_pd_table": "fico_pd_table.csv"
  },
  "external_source_files": {
    "tag_population_targets": "tag_population_targets.csv"
  },
  "required_columns": {
    "loan_identity": ["loan_id", "borrower_id", "portfolio", "product_type", "sector", "balance", "commitment", "interest_rate", "maturity_date", "risk_rating", "fico", "current_pd", "current_lgd"],
    "cre_collateral": ["loan_id", "collateral_id", "cre_sector", "noi", "appraised_value", "occupancy_rate", "debt_service", "ltv", "dscr"],
    "ci_financials": ["loan_id", "borrower_id", "industry", "revenue", "ebitda", "debt_service", "total_debt", "cash", "interest_expense"],
    "fico_pd_table": ["fico_min", "fico_max", "base_pd"]
  },
  "primary_module_priority": ["cre", "ci", "consumer"],
  "near_term_maturity_days": 365,
  "pd_floor": 0.0001,
  "pd_cap": 1.0,
  "lgd_floor": 0.0,
  "lgd_cap": 1.0,
  "default_pd": {
    "cre": 0.025,
    "ci": 0.03,
    "consumer": 0.04
  },
  "default_lgd": {
    "cre": 0.35,
    "ci": 0.45,
    "consumer": 0.55
  },
  "ci_formula_rules": [
    {"formula": "formula_2", "sectors": ["construction"]},
    {"formula": "formula_3", "product_types": ["revolver"]}
  ],
  "dynamic_required_fields": {
    "cre": {
      "standard": {
        "near_term": ["loan_id", "balance", "maturity_date", "cre_sector", "noi", "appraised_value"],
        "longer_term": ["loan_id", "balance", "maturity_date", "cre_sector", "noi", "debt_service_cre"]
      }
    },
    "ci": {
      "formula_1": {
        "near_term": ["loan_id", "balance", "maturity_date", "ebitda", "total_debt"],
        "longer_term": ["loan_id", "balance", "maturity_date", "ebitda", "debt_service_ci", "total_debt", "interest_expense"]
      },
      "formula_2": {
        "near_term": ["loan_id", "balance", "maturity_date", "revenue", "ebitda"],
        "longer_term": ["loan_id", "balance", "maturity_date", "revenue", "ebitda", "debt_service_ci"]
      },
      "formula_3": {
        "near_term": ["loan_id", "balance", "maturity_date", "ebitda", "cash", "total_debt"],
        "longer_term": ["loan_id", "balance", "maturity_date", "ebitda", "cash", "debt_service_ci", "total_debt"]
      }
    },
    "consumer": {
      "standard": {
        "near_term": ["loan_id", "balance", "maturity_date", "fico"],
        "longer_term": ["loan_id", "balance", "maturity_date", "fico"]
      }
    }
  },
  "positive_fields": {
    "cre": ["balance", "noi"],
    "ci": ["balance"],
    "consumer": ["balance"]
  },
  "external_tie_outs_required": true,
  "tie_out_default_tolerance": 0.01
}
